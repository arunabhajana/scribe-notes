{
  "name": "scribe-windows",
  "private": true,
  "license": "MIT",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "version": "npm run sync:version",
    "predev": "npm run sync:version",
    "security:config": "node scripts/check-production-security.mjs",
    "security:check": "node scripts/security-regressions.mjs && node scripts/security-secrets.mjs",
    "prebuild": "npm run sync:version && npm run security:config",
    "pretauri": "npm run sync:version",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "installer:build": "tauri build --config src-tauri/tauri.installer.conf.json --bundles nsis",
    "installer:artwork": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-installer-artwork.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
