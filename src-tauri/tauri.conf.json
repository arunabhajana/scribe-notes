{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "scribe-windows",
    "version": "0.1.0",
    "identifier": "com.tauri.dev",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Scribe",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 620,
                "resizable": true,
                "decorations": false,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["com.scribe.notes"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/scribe-v2/32x32.png",
            "icons/scribe-v2/128x128.png",
            "icons/scribe-v2/128x128@2x.png",
            "icons/scribe-v2/icon.icns",
            "icons/scribe-v2/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
